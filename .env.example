# Required for all examples. Account ids are discovered from the key.
STACKONE_API_KEY=your-stackone-api-key

# Needed by the examples that pin one account: auth_management, langchain_integration,
# langgraph_integration and pydantic_ai_integration
STACKONE_ACCOUNT_ID=your-account-id

# Required for OpenAI-based examples (openai_integration, langchain_integration, langgraph_integration, pydantic_ai_integration)
OPENAI_API_KEY=your-openai-api-key
